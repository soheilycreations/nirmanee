# =============================================================================
# Nirmanee Digital Print House — environment variables
# Copy to .env.local for development. NEVER commit real values.
# On Vercel set these per environment (Production / Preview / Development).
# NEXT_PUBLIC_* values are bundled into the browser — never put secrets there.
# =============================================================================

# --- Site --------------------------------------------------------------------
# Public base URL, no trailing slash. Used for metadata, sitemap, PayHere
# return/cancel URLs and links in emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Default locale for next-intl ("en" | "si")
NEXT_PUBLIC_DEFAULT_LOCALE=en

# --- Supabase ----------------------------------------------------------------
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# SERVER ONLY. Bypasses RLS. Used by checkout, PayHere notify handler, R2
# upload confirmation. Import only from src/lib/supabase/admin.ts ("server-only").
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: for `supabase gen types` / CLI scripts
SUPABASE_PROJECT_REF=your-project-ref

# --- Order / guest access tokens --------------------------------------------
# SERVER ONLY. 32+ random bytes (e.g. `openssl rand -base64 48`). Used to
# sign short-lived cookies (guest cart, order access) — rotate if leaked.
ORDER_TOKEN_SECRET=change-me-to-a-long-random-string

# --- Cloudflare R2 (S3-compatible) ------------------------------------------
# Cloudflare dashboard -> R2 -> Manage API tokens (Object Read & Write, scoped
# to the bucket below). All customer uploads, proofs and print files live here.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# Private bucket for customer uploads / proofs / final print files
R2_BUCKET=nirmanee-jobs
# S3 endpoint: https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
# Optional public bucket/custom domain for catalogue images (product photos)
R2_PUBLIC_BUCKET=nirmanee-public
NEXT_PUBLIC_R2_PUBLIC_URL=https://cdn.example.com
# Presigned URL lifetimes (seconds) and max upload size (bytes, 500 MB)
R2_UPLOAD_URL_TTL=900
R2_DOWNLOAD_URL_TTL=300
NEXT_PUBLIC_MAX_UPLOAD_BYTES=524288000

# --- PayHere -----------------------------------------------------------------
# https://www.payhere.lk -> Settings -> Domains & Credentials
# "true" uses https://sandbox.payhere.lk, "false" uses https://www.payhere.lk
PAYHERE_SANDBOX=true
NEXT_PUBLIC_PAYHERE_MERCHANT_ID=1200000
# SERVER ONLY. Used to build the checkout hash and verify md5sig on notify_url.
PAYHERE_MERCHANT_SECRET=your-merchant-secret
# Optional, only needed for PayHere Retrieval / Refund APIs (P3)
PAYHERE_APP_ID=
PAYHERE_APP_SECRET=
# Derived in code from NEXT_PUBLIC_SITE_URL if empty:
#   return_url  = ${SITE_URL}/checkout/return
#   cancel_url  = ${SITE_URL}/checkout/cancel
#   notify_url  = ${SITE_URL}/api/payhere/notify   (must be publicly reachable)
PAYHERE_NOTIFY_URL=

# --- Bank transfer (shown on checkout for bank_slip payments) ---------------
NEXT_PUBLIC_BANK_ACCOUNT_NAME=
NEXT_PUBLIC_BANK_NAME=
NEXT_PUBLIC_BANK_BRANCH=
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER=

# --- Business contact (used in footer, JSON-LD, emails) ---------------------
NEXT_PUBLIC_WHATSAPP_NUMBER=94779233822
NEXT_PUBLIC_CONTACT_PHONE=+94342040029
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Notifications (P3) ------------------------------------------------------
# Transactional email (Resend recommended)
RESEND_API_KEY=
EMAIL_FROM="Nirmanee Print House <orders@example.com>"
STAFF_NOTIFY_EMAIL=
# WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# SMS gateway (e.g. Notify.lk / Dialog / Text.lk)
SMS_API_USER_ID=
SMS_API_KEY=
SMS_SENDER_ID=

# --- Ops ---------------------------------------------------------------------
# Secret for Vercel Cron routes (abandoned carts, quote expiry, R2 cleanup)
CRON_SECRET=
